# ==============================================================================
# ECHO — ENVIRONMENT CONTRACT (.env.example)
# ==============================================================================

# --- HINDSIGHT CLOUD MEMORY ---
HINDSIGHT_API_URL=https://api.hindsight.vectorize.io
HINDSIGHT_API_KEY=replace-with-your-hindsight-api-key
HINDSIGHT_BANK_ID=support-experiences
HINDSIGHT_TEST_BANK_ID=echo-hindsight-test
HINDSIGHT_TIMEOUT_SECONDS=1.5

# --- GROQ LLM LAYER ---
GROQ_API_KEY=replace-with-your-groq-api-key
GROQ_MODEL=llama-3.3-70b-versatile

# --- SERVER & DEPLOYMENT (FastAPI / Render) ---
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:3000,http://localhost:4173,http://localhost:5173

# --- FRONTEND (Vite / Vercel) ---
VITE_BACKEND_URL=http://localhost:8000
VITE_API_BASE_URL=http://localhost:8000
VITE_WS_BASE_URL=ws://localhost:8000/ws/case